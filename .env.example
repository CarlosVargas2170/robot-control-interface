# Backend Flask/FastAPI (control, Socket.IO)
VITE_BACKEND_URL=http://localhost:5000

# MediaMTX — acepta host solo o URL con path:
#   http://100.99.244.72:8889
#   http://100.99.244.72:8889/camaras/
VITE_MEDIAMTX_URL=http://localhost:8889/camaras/

# Path del mosaic 2×2 (opcional si ya va en VITE_MEDIAMTX_URL)
VITE_COMPOSITE_PATH=camaras

# true = canvas mock | false = stream real
VITE_MOCK_MODE=true

# Layout del stream compuesto: 2x2 | 3x3 | 1x4 | etc.
# Si se define, genera N cámaras automáticamente (sin tocar backend.ts).
# Si no se define, usa el catálogo hardcodeado (2×2 con nombres personalizados).
VITE_CAMERA_LAYOUT=2x2

# mediamtx = catálogo en src/config/backend.ts | api = GET /api/cameras
VITE_CAMERA_SOURCE=mediamtx

# composite-crop | webrtc | mjpeg
VITE_VIDEO_STRATEGY=composite-crop

# Panel independiente de Robot Mesero (`?app=mesero`)
# El servicio de control de cada Mesero usa su propia URL en el puerto 5050.
# Opcional: reemplaza el catálogo completo con un arreglo JSON de objetos
# `{ "id": "...", "label": "...", "url": "http://host:5050" }`.
# VITE_MESERO_CONTROL_URLS=[{"id":"mesero-1","label":"Mesero 1","url":"http://localhost:5050"}]
# El token TTS es opcional: también puede ingresarse durante la sesión desde
# el panel. Como toda variable VITE_ se entrega al navegador, no la trates
# como un secreto de servidor.
VITE_MESERO_TTS_TOKEN=
